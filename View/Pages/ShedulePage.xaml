<Page x:Class="Kursovaya.View.Pages.ShedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursovaya.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" 
      d:DesignWidth="1000"
      Title="Расписание занятий" 
      Background="#FFD4DFE7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Блок с расписанием -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Padding="20"
                BorderBrush="#017695"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Auto">
                <DataGrid Name="SheduleDg" 
                          SelectionChanged="SheduleDg_SelectionChanged" 
                          Background="White"  
                          AutoGenerateColumns="False"
                          Width="800"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Single">

                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#017695"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFD4DFE7"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Название секции с иконкой -->
                        <DataGridTemplateColumn Header="Секция" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0">
                                        <Border Width="8" 
                                                Height="8" 
                                                CornerRadius="4" 
                                                Background="#017695" 
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Section.Title}" 
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Дата -->
                        <DataGridTemplateColumn Header="Дата" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" 
                                                HorizontalAlignment="Center" 
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                                   FontSize="14"
                                                   Foreground="#017695"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Время начала -->
                        <DataGridTemplateColumn Header="Начало" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F0F5" 
                                            CornerRadius="5" 
                                            Padding="8,3">
                                        <TextBlock Text="{Binding StartTime}" 
                                                   FontSize="13"
                                                   Foreground="#017695"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Время конца -->
                        <DataGridTemplateColumn Header="Конец" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F0F5" 
                                            CornerRadius="5" 
                                            Padding="8,3">
                                        <TextBlock Text="{Binding EndTime}" 
                                                   FontSize="13"
                                                   Foreground="#017695"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Время конца -->
                        <DataGridTemplateColumn Header="Тренер" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F0F5" 
                      CornerRadius="5" 
                      Padding="8,3">
                                        <TextBlock Text="{Binding User.FullName}" 
                             FontSize="13"
                             Foreground="#017695"
                             HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>