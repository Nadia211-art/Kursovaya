<Page x:Class="Kursovaya.View.Pages.NewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursovaya.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="420" 
      d:DesignWidth="970" 
      Title="Новости спортивного клуба">

    <Grid Margin="10">
        <ListBox Background="#D4DFE7" 
                 Name="NewsLb"  
                 ScrollViewer.VerticalScrollBarVisibility="Auto" 
                 BorderThickness="0" 
                 SelectionChanged="NewsLb_SelectionChanged">

            <!-- Изменяем ItemsPanel на StackPanel для вертикального расположения -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" 
                            CornerRadius="15" 
                            Margin="15" 
                            Padding="15" 
                            Width="900" 
                            Height="400"
                            BorderBrush="#017695" 
                            BorderThickness="0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка с изображением -->
                            <Border Grid.Column="0" 
                                    CornerRadius="10" 
                                    Margin="0,0,15,0" 
                                    Background="Transparent"
                                    BorderBrush="#017695"
                                    BorderThickness="0">
                                <Image Source="{Binding Photo}" 
                                       Height="250" 
                                       Width="270" 
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Title}"/>
                            </Border>

                            <!-- Правая колонка с контентом -->
                            <Grid Grid.Column="1" Margin="10,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок -->
                                <TextBlock Grid.Row="0" 
                                           Foreground="#017695" 
                                           Text="{Binding Title}" 
                                           FontWeight="Bold" 
                                           FontSize="22" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,10"/>

                                <!-- Дата новости -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                           Foreground="#017695" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10"/>

                                <!-- Краткое содержание -->
                                <Border Grid.Row="2" 
                                        Background="#F0F5F8" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        BorderBrush="#017695"
                                        BorderThickness="0.5">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                                  MaxHeight="200">
                                        <TextBlock Text="{Binding NewContent}" 
                                                   TextWrapping="Wrap" 
                                                   Foreground="#333" 
                                                   FontSize="14" 
                                                   LineHeight="20"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                          
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.01" ScaleY="1.01"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Page>