<Page x:Class="Kursovaya.View.Pages.ApplicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursovaya.View.Pages"
      mc:Ignorable="d" 
       d:DesignHeight="410" d:DesignWidth="1000"
  Title="Главная страница" >
    <Grid Margin="5 0 5 0">
        <ListView Name="ApplicationLv">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ФИО" DisplayMemberBinding="{Binding User.FullName}"/>
                    <GridViewColumn Header="Секция" DisplayMemberBinding="{Binding Section.Title}"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding ApplicationDate, StringFormat=dd.MM.yyyy}"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
