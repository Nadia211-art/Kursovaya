<Page x:Class="Kursovaya.View.Pages.AdminApplicationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursovaya.View.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" 
      d:DesignWidth="970" 
      Title="Просмотр заявок" Background="#FFD4DFE7">

    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Панель фильтрации -->
        <Border Grid.Row="1" 
                Background="#f0f0f0" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр по статусу:" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>
                <ComboBox Name="StatusFilterCombo" 
                          SelectionChanged="StatusFilterCombo_SelectionChanged"
                          Width="150">
                    <ComboBoxItem Content="Все заявки" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Новые" Tag="Новая"/>
                    <ComboBoxItem Content="Принятые" Tag="Принята"/>
                    <ComboBoxItem Content="Отклоненные" Tag="Отклонена"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ListView с заявками -->
        <ListView Grid.Row="2" 
                  Name="ApplicationLv" 
                  SelectionChanged="ApplicationLv_SelectionChanged"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Студент" Width="300" 
                                    DisplayMemberBinding="{Binding User.FullName}"/>

                    <GridViewColumn Header="Секция" Width="150" 
                                    DisplayMemberBinding="{Binding Section.Title}"/>

                    <GridViewColumn Header="Дата заявки" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ApplicationDate, StringFormat=dd.MM.yyyy}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Статус" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Name="StatusText" 
                                           Text="{Binding Status}"
                                           FontWeight="{Binding Status, ConverterParameter=Новая}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Новая">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Принята">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Отклонена">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Панель управления -->
        <Border Grid.Row="3" 
                Background="#f0f0f0" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Name="SelectedInfoText" 
                           Text="Выберите заявку" 
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1" 
                        Name="AcceptButton" 
                        Content="Принять заявку" 
                        Click="AcceptButton_Click"
                        Background="Green" 
                        Foreground="White"
                        Padding="15,5" 
                        Margin="5"
                        IsEnabled="False"/>

                <Button Grid.Column="2" 
                        Name="RejectButton" 
                        Content="Отклонить заявку" 
                        Click="RejectButton_Click"
                        Background="Red" 
                        Foreground="White"
                        Padding="15,5" 
                        Margin="5"
                        IsEnabled="False"/>
            </Grid>
        </Border>
    </Grid>
</Page>