<Window x:Class="Kursovaya.View.Windows.NewApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kursovaya.View.Windows"
        mc:Ignorable="d"
          Title="Окно заполнения заявки" Height="700" Width="1000" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFD4DFE7" Loaded="Window_Loaded" >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Image Source="C:\Users\dns\source\repos\Kursovaya\Resources\Image\нижний фон.png" Grid.Row="2" Grid.Column="1" Stretch="None"/>
        <Image Source="C:\Users\dns\source\repos\Kursovaya\Resources\Image\ЛОГОТИП (2).png"  Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 10"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="40" />
                <RowDefinition Height="50" />
                <RowDefinition Height="20" />
                <RowDefinition Height="50" />
                <RowDefinition Height="30" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TextBlock  Text="Заполнение анкеты" Grid.ColumnSpan="3"  VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="25" FontFamily="Jomolhari" Foreground="#017695"/>
            <TextBlock Text="ФИО:" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Name="FullnameTb" Grid.Row="2" Grid.Column="2" Width="300" 
                     HorizontalAlignment="Left" 
                     Text="{Binding сurrentUser.FullName, Mode=OneWay}"
                     IsReadOnly="True"/>
            <TextBlock Text="Выбранная секция:" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <TextBlock  Name="SelectedSectionTbl" Grid.Row="4" Grid.Column="2" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                <Button  Name="ExitBtn"  Grid.ColumnSpan="3" Width="200" Content="Назад" Click="ExitBtn_Click"  Margin="0 0 10 0" />
                <Button  Name="RecordBtn"  Grid.ColumnSpan="3" Width="200"  Content="Отправить заявку" Click="RecordBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
