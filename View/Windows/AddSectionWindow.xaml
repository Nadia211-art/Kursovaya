<Window x:Class="Kursovaya.View.Windows.AddSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kursovaya.View.Windows"
        mc:Ignorable="d"
                  Title="Добавить секцию" SizeToContent="WidthAndHeight" ResizeMode="NoResize" Background="#FFD4DFE7" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" VerticalAlignment="Center"/>
        <TextBox Name="NameTb" Grid.Column="2" MaxLength="150" Text="{Binding Title}" />

        <TextBlock Text="Фото:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox Name="PhotoTb" Grid.Column="2" Grid.Row="2" Text="{Binding Photo}"/>

        <TextBlock Text="Описание:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox Name="DescriptionTb" Grid.Column="2" Grid.Row="4" Text="{Binding Description}"/>
        <StackPanel Grid.Column="2" Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Загрузить" Name="LoadFromPCBtn"  Click="LoadFromPCBtn_Click" Width="150"/>
            <Button Content="Добавить" Name="AddBtn" Click="AddBtn_Click" Width="150" Margin="5 0 0 0"/>
        </StackPanel>
    </Grid>
</Window>
