<Window x:Class="Kursovaya.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kursovaya.View.Windows"
        mc:Ignorable="d"
        Title="Окно авторизации" Height="700" Width="1000" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFD4DFE7"  >
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="301" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <Image Source="C:\Users\dns\source\repos\Kursovaya\Resources\Image\боковой фон.png" Grid.RowSpan="3" Stretch="None"/>
        <Image Source="C:\Users\dns\source\repos\Kursovaya\Resources\Image\нижний фон.png" Grid.Row="2" Grid.Column="1" Stretch="None"/>
        <Image Source="C:\Users\dns\source\repos\Kursovaya\Resources\Image\ЛОГОТИП (2).png"  Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 10"/>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="50" />
                <RowDefinition Height="20" />
                <RowDefinition Height="50" />
                <RowDefinition Height="60" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TextBlock  Text="Вход в систему" Grid.ColumnSpan="3"  VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="25" FontFamily="Jomolhari" Foreground="#017695"/>
            <TextBlock Text="Логин:" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox  Name="LoginTb" Grid.Row="1" Grid.Column="2" Width="300" HorizontalAlignment="Left"/>
            <TextBlock Text="Пароль:" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <PasswordBox Name="PasswordPb" Grid.Row="3" Grid.Column="2" Width="300" HorizontalAlignment="Left"/>
            <CheckBox Name="RememberChB" Grid.Row="4" Grid.Column="2" Content="Запомнить меня" IsChecked="False" />
            <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                <Button  Name="LoginBtn" Grid.Row="5" Grid.ColumnSpan="3" Width="200" Content="Войти" Click="LoginBtn_Click" Margin="0 0 10 0" />
                <Button  Name="RegictrationBtn" Grid.Row="7" Grid.ColumnSpan="3" Width="250"  Content="Зарегистрироваться" Click="RegictrationBtn_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
